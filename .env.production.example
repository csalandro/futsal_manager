# Base remota (producción). Copiá este archivo a .env.production, completalo y corré:
#   npm run db:remote
# .env.production no se versiona (está en .gitignore).

# Supabase → Connect → "Session pooler" (puerto 5432). Reemplazá [YOUR-PASSWORD].
# Si la contraseña tiene símbolos (@ # / ? %), cambiala por una sin símbolos.
# Si aparece un error de certificado, agregá al final: ?sslmode=require&uselibpqcompat=true
DATABASE_URL=postgresql://postgres.<ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres

# Usuario administrador de producción (usá una contraseña distinta a la local, mínimo 8 caracteres).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
