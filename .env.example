# Copiar a .env y completar (o correr `npm run setup`, que lo genera con secretos al azar).

# Postgres en Docker (docker compose up -d)
POSTGRES_USER=futsal
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=futsal_manager
POSTGRES_PORT=5432

# Prisma (debe coincidir con lo de arriba)
DATABASE_URL=postgresql://futsal:cambiame@localhost:5432/futsal_manager?schema=public

# API
API_PORT=3001
# Puerto de la app completa en Docker (docker compose up): http://localhost:3000
APP_PORT=3000
# Producción con HTTPS (Vercel, etc.): true. Local por http: false o vacío.
COOKIE_SECURE=
# Saltos de proxy en los que confiar para la IP del cliente (Vercel: 1). Sin proxy: vacío.
TRUST_PROXY=
# Conexiones máximas por instancia. En serverless, bajo (ej. 3).
DB_POOL_MAX=
# Al menos 32 caracteres al azar
JWT_SECRET=

# Usuario administrador que crea el seed (npm run db:seed). Mínimo 8 caracteres.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
