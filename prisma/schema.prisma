// Esquema de la base. Después de cambiarlo: `npm run db:migrate -- --name <cambio>`.

generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String
  passwordHash String
  role         Role     @default(USER)
  active       Boolean  @default(true)
  /// Se incrementa al cambiar la contraseña o desactivar: invalida las sesiones abiertas.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  saves        Save[]
}

/// Partida guardada: una por usuario y ranura (1..3). El estado completo del juego va en JSON.
model Save {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot      Int
  version   Int
  season    Int
  teamName  String?
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, slot])
}
